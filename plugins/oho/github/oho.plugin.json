  "compatibility": {
    "ohoPackApi": "1",
    "mcp": [
      "2025-06-18"
    ]
  },
  "runtime": {
    "kind": "remote_mcp",
    "supportedExecutors": [
      "oho_client"
    ],
    "protocolVersion": "2025-06-18",
    "endpoint": {
      "kind": "per_installation",
      "baseUrlField": "base_url",
      "path": "/mcp/github"
    },
    "auth": {
      "kind": "bearer_token",
      "secretField": "access_token"
    }
  },
