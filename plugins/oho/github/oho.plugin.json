        "outputSchema": {
          "type": "object"
        },
        "risk": "medium",
        "sideEffect": "none",
        "network": "restricted",
        "timeoutMs": 20000,
        "maxCallsPerRun": 6,
        "executionMode": "sequential",
        "displayDescription": "阅读仓库中的指定文件，例如说明文档或源代码。",
        "defaultMode": "allowed"
      },
