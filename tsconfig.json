{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "outDir": "build"
  },
  "include": [
    "runtime/**/*.ts",
    "plugins/oho/*/src/**/*.ts",
    "providers/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "plugins/oho/developer-toolkit"
  ]
}
